# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model for multimodal nameplate extraction (default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# ALLOWED_EMAILS: Comma-separated list of inspector emails authorized to use MarineTag AI
ALLOWED_EMAILS="phantrongkhoi1710@gmail.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

